<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leave fields blank to ignore them"
            android:textColor="#0B6623"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/RoundedExposedDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Month / Year">

            <AutoCompleteTextView
                android:id="@+id/spinnerFilterMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/RoundedOutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Specific Date (e.g., 04/10/2026)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFilterDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/RoundedOutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Barcode">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFilterBarcode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/RoundedOutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Bill No.">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFilterBillNo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/RoundedOutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Jappa (e.g., E200)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFilterJappa" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/RoundedOutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Mill Rate">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFilterMillRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/RoundedOutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Salesman No.">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFilterSalesman" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
